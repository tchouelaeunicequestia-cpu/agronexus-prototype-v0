# AgroNexus Deployment Environment Configuration Template

# Local PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DB=agronexus
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_to_your_local_postgres_password

# Spring Boot JDBC Configuration
DB_URL=jdbc:postgresql://localhost:5434/agronexus
DB_USER=postgres
DB_PASS=change_this_to_your_local_postgres_password

# Security & Authentication
JWT_SECRET=super_secret_jwt_key_must_be_at_least_256_bits_long_agronexus_2026

# RAG AI Vector Service Credentials
SPRING_AI_OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# API Base URL for Frontend Build
API_BASE_URL=https://agronexus-backend.onrender.com/api/v1
